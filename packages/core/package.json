{
  "name": "@linzopen/css-guard",
  "version": "0.1.0",
  "description": "Refuse stylesheets that can steal what your users type. A linter and safe-injection engine for user-supplied CSS.",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": {
      "browser": "./src/browser.js",
      "default": "./src/index.js"
    },
    "./browser": "./src/browser.js",
    "./schema": "./schema/skin.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "schema",
    "README.md"
  ],
  "keywords": [
    "css",
    "security",
    "linter",
    "sanitize",
    "user-css",
    "userstyle",
    "theme",
    "exfiltration",
    "electron",
    "css-injection",
    "attribute-selector"
  ],
  "engines": {
    "node": ">=20"
  },
  "browser": "./src/browser.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinzOpen/dsh-skin.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/LinzOpen/dsh-skin#readme",
  "bugs": {
    "url": "https://github.com/LinzOpen/dsh-skin/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
