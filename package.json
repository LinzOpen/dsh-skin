{
  "name": "css-guard-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Skin engine, studio app and SDK for Electron / web UIs",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm start --workspace @css-guard/app",
    "build:skins": "node scripts/build-skins.js",
    "build:demo": "node scripts/build-demo.js",
    "test": "node --test packages/core/test/*.test.js",
    "validate": "node packages/cli/bin/css-guard.js validate skins",
    "lint": "node scripts/check-repo.js",
    "check": "npm run lint && npm test && npm run validate",
    "pack:mac": "npm run pack:mac --workspace @css-guard/app",
    "pack:win": "npm run pack:win --workspace @css-guard/app",
    "pack:linux": "npm run pack:linux --workspace @css-guard/app",
    "test:adapter": "node --test adapters/dsh/test/*.test.js",
    "test:e2e": "electron app/test/smoke.js && electron packages/electron/test/smoke.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinzOpen/css-guard.git"
  },
  "bugs": {
    "url": "https://github.com/LinzOpen/css-guard/issues"
  },
  "homepage": "https://github.com/LinzOpen/css-guard#readme"
}
